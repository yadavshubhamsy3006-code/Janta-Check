# GEMINI_API_KEY: Required for server-side Gemini AI image analysis.
# Configure in Settings > Secrets in AI Studio or .env locally.
GEMINI_API_KEY=

# APP_URL: The public URL where this application is hosted.
APP_URL=

# Supabase Configuration (Optional for Demo Mode, Required for Live Production Mode)
# Client-exposed Supabase project URL and anonymous key (Vite prefix required):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase Service Role Key (NEVER expose in frontend/VITE_ variables):
SUPABASE_SERVICE_ROLE_KEY=

# Optional Session Signing Secret (falls back to secure runtime random bytes if unset):
SESSION_SECRET=
